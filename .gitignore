# Local, generated and secret files. Raw data and SQLite databases never go to git (docs/WORKFLOW.md).

node_modules
coverage
.vite
dist/
.vscode
*.tsbuildinfo
.DS_Store
.env
.env.local
.env.*
!.env.example

*.log

**/data/*.sqlite*
**/data/**/*.sqlite*
data/raw/

# Per-user profile exports stay local unless `pnpm etl profile-sync --publish`
# writes the anonymized copy under data/public/profiles/ (D-069).
data/users/

# Generated ETL exports are distributed via the state release's
# public-exports.tar.gz asset and `pnpm etl pull` (D-078/D-079); they are
# never committed (this also covers data/public/backtest-*.json and
# data/public/profiles/).
data/public/

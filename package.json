{
  "name": "draftorb",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Free League of Legends draft and itemization assistant",
  "scripts": {
    "dev": "pnpm --filter @draftorb/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "etl": "tsx packages/etl/src/cli.ts",
    "validate:tags": "tsx packages/etl/src/cli.ts validate-tags",
    "migrate": "tsx packages/etl/src/cli.ts migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.18.5",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}

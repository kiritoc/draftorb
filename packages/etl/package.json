{
  "name": "@draftorb/etl",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@draftorb/engine": "workspace:*",
    "@draftorb/shared": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "etl": "tsx src/cli.ts",
    "static": "tsx src/cli.ts static",
    "validate-tags": "tsx src/cli.ts validate-tags",
    "migrate": "tsx src/cli.ts migrate"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
